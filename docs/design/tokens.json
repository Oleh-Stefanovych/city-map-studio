{
  "$comment": "Design tokens extracted from the City Map Studio mock (docs/design/source/Main.dc.html). Hex values are authoritative; map them onto the shadcn/Tailwind CSS variables in src/renderer/index.css.",
  "font": {
    "family": "-apple-system, 'SF Pro Text', 'Helvetica Neue', sans-serif",
    "serifNumerals": "Georgia, 'Times New Roman', serif",
    "size": { "base": 13, "control": 12.5, "help": 11.5, "caption": 11, "dialogTitle": 16, "paneTitle": 15 },
    "sectionLabel": { "size": 11, "weight": 700, "tracking": "0.06em", "transform": "uppercase" }
  },
  "color": {
    "ink": "#1E2430",
    "muted": "#5B6372",
    "mutedStrong": "#4A5160",
    "windowBg": "#ECEDEF",
    "panelBg": "#F7F7F8",
    "barBg": "#F1F2F4",
    "toolbarGradient": ["#FCFCFD", "#F0F1F4"],
    "fieldBg": "#FFFFFF",
    "border": "#D6D8DD",
    "borderField": "#CBCED6",
    "borderWindow": "#BFC3CB",
    "divider": "#CBCED5",
    "dividerGrip": "#B7BBC4",
    "segmentedTrack": "#E4E6EA",
    "tabTrack": "#E1E4E9",
    "sliderTrack": "#D5D8DE",
    "statBg": "#E9EAEE",
    "switchOff": "#B3B8C2",
    "accent": "#C9431B",
    "accentGradient": ["#D5502A", "#BE3E17"],
    "accentBorder": "#AE3712",
    "mapSelection": "#E2572B",
    "mapSelectionFill": "rgba(226,87,43,0.10)",
    "mapDim": "rgba(24,28,40,0.34)",
    "focusRing": "#2F6FED"
  },
  "status": {
    "none":       { "bg": "#E3E5EA", "fg": "#3A4150", "dot": "#8A91A0" },
    "stale":      { "bg": "#FFF1CC", "fg": "#5C3B00", "dot": "#D99100", "border": "#E6C56A" },
    "generating": { "bg": "#E4EEFF", "fg": "#17408F", "dot": "#2F6FED" },
    "ready":      { "bg": "#DDF3E4", "fg": "#14532D", "dot": "#1E9E55", "border": "#A9D6B8" }
  },
  "coverageBanner": {
    "ok":      { "bg": "#E8F5EC", "border": "#BFE0CB", "title": "#0F4F2B", "sub": "#3B5E49", "icon": "#14753F" },
    "partial": { "bg": "#FFF4D6", "border": "#EBCB83", "title": "#5C3B00", "sub": "#6E5320", "icon": "#8A5A00" },
    "missing": { "bg": "#FBE8E4", "border": "#EFB8AC", "title": "#6E1A08", "sub": "#7A3A2C", "icon": "#A3280F" }
  },
  "model3d": {
    "$comment": "Preview colours are keyed by layer, so the preview reads like a multi-colour print. Use the same colours as 3MF base materials.",
    "viewportBg": ["#E6E9EE", "#D8DBE0", "#CBCFD7"],
    "foundation": { "top": "#E9DFC9", "wall": "#C8BA9C", "recessWall": "#B9AB8C" },
    "base": { "wall": "#8FB1C4" },
    "waterRecessFloor": "#7DB3D1",
    "waterThroughOpening": "#D8DBE0",
    "roadsAndRail": { "top": "#3C4558", "wall": "#222833" },
    "border": { "top": "#9C6A47", "wall": "#6B4630" },
    "clockRaised": { "top": "#E3B25B", "wall": "#9A7430" },
    "clockEngravedOnBorder": "#E9DFC9",
    "clockEngravedInMap": "#A89C80",
    "centreHoleInner": "#8A7C60",
    "contactShadow": "rgba(30,36,50,0.30)"
  },
  "osmBasemap": {
    "$comment": "Left-pane basemap, OSM-standard-like palette, drawn from the local PBF.",
    "land": "#F2EFE9", "water": "#AAD3DF", "park": "#CDEBB0", "building": "#D9D0C9",
    "minorRoad": { "fill": "#FFFFFF", "casing": "#D3CEC4" },
    "majorRoad": { "fill": "#FCD6A4", "casing": "#C99A55" },
    "trunkOrMotorway": { "fill": "#F4A3AE", "casing": "#CC6677" },
    "railway": { "line": "#8C8C8C", "dash": "#FFFFFF" },
    "label": "#6B6B6B", "labelCity": "#2B2B2B", "labelWater": "#4F86A0",
    "noDataBg": "#ECEDEF", "noDataGrid": "#DADCE1", "outsideCoverageHatch": "rgba(60,66,80,0.10)"
  },
  "radius": { "window": 12, "button": 7, "buttonLarge": 8, "field": 6, "segmented": 8, "segmentedItem": 6, "tabPill": 8, "card": 10, "dialog": 14, "pill": 14 },
  "shadow": {
    "segmentedActive": "0 1px 2px rgba(0,0,0,.18)",
    "tabActive": "0 1px 3px rgba(20,26,40,.2)",
    "floatingCard": "0 4px 14px rgba(30,36,50,.14)",
    "progressCard": "0 18px 40px rgba(20,26,40,.22)",
    "dialog": "0 24px 60px rgba(10,14,24,.35)"
  },
  "layout": {
    "window": { "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 700 },
    "toolbarHeight": 52, "statusBarHeight": 28,
    "leftPane": { "default": 400, "min": 320, "max": 560 },
    "rightPane": { "default": 380, "min": 340, "max": 480 },
    "centrePane": { "min": 420 },
    "tabBarHeight": 48, "tabPillHeight": 30,
    "settingsRowMinHeight": 34, "settingsRowPadding": "4px 16px",
    "sliderWidth": 88, "numberFieldWidth": 78, "switch": { "width": 36, "height": 20, "knob": 16 },
    "dividerWidth": 1, "dividerGrip": { "width": 5, "height": 32 },
    "dialogWidth": 540, "progressCardWidth": 340
  }
}
